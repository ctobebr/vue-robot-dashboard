# // 修改SN

VITE_DEVICE_SN=B2TH220001
# 使用Vite代理，相对路径即可
# 设置VITE_API_BASE_URL为/api  配合vite.config.js中的代理请求设置
# - 避免跨域问题 ：开发时浏览器直接请求后端会有 CORS 限制，通过 Vite 代理转发解决
# - 环境切换方便 ：开发用代理，生产用 Nginx 反向代理，代码里都用 /api 即可
# - 配置集中 ：后端地址只配在 vite.config.js 里，不用每个接口都写完整 URL

# /api 是相对路径，让 Vite 开发服务器代理转发到后端，解决开发环境的跨域问题。
# 注意：WebSocket 连接需要直接连接后端服务器，不经过 Vite 代理
# ============================================
# 后端服务器配置
# 修改以下IP地址即可切换不同环境
# ============================================

# 主服务器IP（WebSocket和API）
# 172.30.14.57 - 测试服务器（当前使用）
# 172.30.22.97 - 云端服务器
# 172.30.1.132 - 测试服务器（局域网）
# 192.168.123.38 - 机器人局域网（内网环境使用）
# VITE_SERVER_IP=172.30.14.57

VITE_SERVER_IP= 172.30.14.241

# 主服务器端口
VITE_SERVER_PORT=8080

# 推流服务器端口
VITE_STREAM_PORT=10800

# ============================================
# 以下配置通常不需要修改
# ============================================

# API基础URL（使用Vite代理，相对路径即可）
VITE_API_BASE_URL=/api

# WebSocket服务器完整地址（根据上面的配置自动拼接）
# 格式: http://IP:端口
VITE_SOCKET_URL=http://172.30.14.241:8080
