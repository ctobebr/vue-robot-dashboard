# ============================================
# 开发环境配置
# ============================================

# 后端服务器IP
# 172.30.14.57 - 测试服务器（当前使用）
# 172.30.22.97 - 云端服务器
# 172.30.1.132 - 测试服务器（局域网）
VITE_SERVER_IP=192.168.1.109

# 主服务器端口
VITE_SERVER_PORT=8080

# 推流服务器端口
VITE_STREAM_PORT=10800

# API基础URL（开发环境使用相对路径，走Vite代理）
VITE_API_BASE_URL=/api

# WebSocket服务器地址
VITE_SOCKET_URL=http://192.168.1.109:8080

# 设备SN
VITE_DEVICE_SN=B2TH220001
